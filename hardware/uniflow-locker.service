[Unit]
Description=UniStow Locker 4 controller
Wants=pigpiod.service network-online.target
After=pigpiod.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=nikitsya
WorkingDirectory=/home/nikitsya/Desktop
ExecStart=/home/nikitsya/.venvs/unistow/bin/python -u /home/nikitsya/Desktop/run_locker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
