POSTGRES_PASSWORD=
POSTGRES_PORT=5433
POSTGRES_USER=unistow
POSTGRES_DB=unistow
COMPOSE_PROJECT_NAME=unistow

# Stripe test environment only.
STRIPE_SECRET_KEY=
APP_BASE_URL=http://127.0.0.1:8000
UNISTOW_OVERDUE_BILLING=0
STRIPE_WEBHOOK_SECRET=

# Shared only with the physical Locker 4 device.
UNISTOW_DEVICE_KEY=

# For local MQTT, set MQTT_HOST=localhost and use an absolute CA file path.
MQTT_HOST=
MQTT_PORT=8883
MQTT_CA_FILE=
MQTT_APP_PASSWORD=
UNISTOW_MQTT_OPEN=0
UNISTOW_OPEN_TEST=0

POSTGRES_SSLROOTCERT=.local-postgres/server.crt
